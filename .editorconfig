root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.html]
indent_size = 2

[*.css]
indent_size = 2

[*.scss]
indent_size = 2

[*.js]
indent_size = 2

[*.json]
indent_size = 2
charset = utf-8

[*.md]
trim_trailing_whitespace = false

[nginx.conf]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2