# .env.example
# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - NO USAR DIRECTAMENTE
# =============================================================================
# Este archivo es una plantilla de referencia. NO contiene valores reales.
# Para ejecutar la aplicación debes:
#   1. Copiar este archivo: cp .env.example .env
#   2. Reemplazar TODOS los valores placeholder con los valores reales
#   3. Nunca subas el archivo .env al repositorio (está en .gitignore)
# =============================================================================
# JIRA: XP-9
# =============================================================================

# === SERVER ===

# Puerto en el que escuchará el servidor Express.
# Tipo: número entero válido de puerto (1-65535). Obligatoria.
PORT=3000

# Entorno de ejecución de Node.js.
# Valores válidos: development | test | production. Obligatoria.
NODE_ENV=development

# === JWT ===

# Secreto usado por jsonwebtoken para firmar y verificar tokens.
# Debe ser una cadena larga, aleatoria y criptográficamente segura (mínimo 64 caracteres).
# NUNCA debe ser un valor corto, predecible o reutilizado entre entornos. Obligatoria.
JWT_SECRET=your_long_random_cryptographically_secure_secret_here

# Duración de expiración del token JWT.
# Formato aceptado por jsonwebtoken: 15m, 1h, 7d, etc. Obligatoria.
JWT_EXPIRES_IN=1h

# === CORS ===

# Lista blanca de orígenes permitidos para las solicitudes CORS.
# Formato: URLs separadas por comas, sin espacios entre ellas.
# En producción deben ser únicamente los dominios autorizados. Obligatoria.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# === RATE LIMITING ===

# Ventana de tiempo del rate limiter expresada en milisegundos.
# El valor de ejemplo equivale a 15 minutos (15 * 60 * 1000 = 900000).
# Opcional, con fallback en código.
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de requests permitidos por IP dentro de la ventana de tiempo.
# Valor por defecto recomendado: 100 requests por ventana. Opcional, con fallback en código.
RATE_LIMIT_MAX_REQUESTS=100

# === LOGGING ===

# Nivel de logging para Winston.
# Valores válidos: error | warn | info | http | debug.
# En producción se recomienda warn o error. En desarrollo se recomienda debug o info.
# Opcional, con fallback en código.
LOG_LEVEL=info