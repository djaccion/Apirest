# ============================================================
# .env.example — ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================
# ADVERTENCIA: Este archivo es únicamente una plantilla de referencia.
# NO contiene valores reales ni secretos de ningún tipo.
#
# INSTRUCCIONES:
#   1. Copiar este archivo como `.env` en la raíz del proyecto.
#   2. Reemplazar los valores de ejemplo con los valores reales
#      correspondientes a tu entorno.
#   3. El archivo `.env` NUNCA debe versionarse en el repositorio.
#      Verificar que `.env` esté incluido en `.gitignore`.
#   4. Los secretos (especialmente JWT_SECRET) deben rotarse
#      periódicamente según la política de seguridad del equipo.
#
# Para instrucciones sobre cómo generar un JWT_SECRET seguro,
# consultar el README.md (sección "Configuración de entorno") o
# la documentación interna del proyecto.
# ============================================================


# ------------------------------------------------------------
# BLOQUE 1 — Configuración general de la aplicación
# ------------------------------------------------------------

# Puerto en el que escucha el servidor HTTP.
# Valor por defecto recomendado para desarrollo local: 3000.
PORT=3000

# Entorno de ejecución de la aplicación.
# Valores válidos: development | staging | production
# Afecta el comportamiento de logs, Swagger y optimizaciones.
NODE_ENV=development

# Nombre de la aplicación. Utilizado en logs estructurados
# y como título en la documentación Swagger UI.
APP_NAME=xp-api

# Versión de la API. Se usa como prefijo en las rutas (ej. /v1/...)
# y como versión en la especificación Swagger.
API_VERSION=v1


# ------------------------------------------------------------
# BLOQUE 2 — Seguridad y autenticación JWT
# ------------------------------------------------------------

# Secreto utilizado para firmar y verificar los tokens JWT.
# RESTRICCIÓN DE SEGURIDAD: En producción, este valor DEBE tener
# un mínimo de 64 caracteres aleatorios y gestionarse mediante
# un vault o secrets manager (ej. HashiCorp Vault, AWS Secrets Manager).
# NUNCA usar un valor predecible o hardcodeado en producción.
# Para generar un secreto seguro ejecutar:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Consultar README.md para más detalles.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_SEGURO_DE_MINIMO_64_CARACTERES

# Tiempo de expiración de los tokens JWT emitidos.
# Formatos aceptados por jsonwebtoken: 15m, 1h, 7d, 30d, etc.
# Valor recomendado para producción: 15m (con refresh token).
JWT_EXPIRES_IN=1h


# ------------------------------------------------------------
# BLOQUE 3 — CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------

# Lista de orígenes autorizados para realizar peticiones cross-origin.
# Separar múltiples orígenes con coma, sin espacios entre ellos.
# PRODUCCIÓN: Listar únicamente los dominios autorizados y verificados.
# Nunca usar wildcard (*) en entornos productivos con autenticación.
# Ejemplo producción: https://app.midominio.com,https://admin.midominio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200


# ------------------------------------------------------------
# BLOQUE 4 — Rate Limiting
# ------------------------------------------------------------

# Duración de la ventana de tiempo para el rate limiting, en milisegundos.
# Valor de ejemplo: 900000 ms = 15 minutos.
# Ajustar según los requisitos de carga y seguridad del entorno.
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de peticiones permitidas por IP dentro de la ventana
# de tiempo definida en RATE_LIMIT_WINDOW_MS.
# Reducir este valor en producción si se detectan patrones de abuso.
RATE_LIMIT_MAX_REQUESTS=100


# ------------------------------------------------------------
# BLOQUE 5 — Logging
# ------------------------------------------------------------

# Nivel de verbosidad del logger Winston.
# Valores válidos (de menor a mayor detalle):
#   error | warn | info | http | debug
# Recomendado para producción: info
# Recomendado para desarrollo: debug (incluye trazas detalladas)
LOG_LEVEL=info

# Habilita la escritura de logs en archivos físicos además de consola.
# Tipo: booleano como string ("true" | "false").
# En producción considerar habilitarlo (true) para auditoría y SIEM.
# Los archivos se generarán en el directorio /logs del proyecto.
LOG_TO_FILE=false


# ------------------------------------------------------------
# BLOQUE 6 — Base de datos (preparación futura)
# ------------------------------------------------------------

# FUTURO — No utilizado en esta iteración.
# URI de conexión a la instancia de MongoDB.
# Formato: mongodb://usuario:password@host:puerto/nombre_db
# En producción gestionar mediante vault o secrets manager.
MONGODB_URI=mongodb://localhost:27017/xp-api

# FUTURO — No utilizado en esta iteración.
# Nombre de la base de datos MongoDB que utilizará la aplicación.
MONGODB_DB_NAME=xp-api


# ------------------------------------------------------------
# BLOQUE 7 — Documentación Swagger
# ------------------------------------------------------------

# Habilita o deshabilita la exposición del endpoint de Swagger UI
# en la ruta /api-docs (o la configurada en el servidor).
# Tipo: booleano como string ("true" | "false").
# ADVERTENCIA: Establecer en false en entornos de producción para
# evitar exponer la superficie de la API públicamente.
SWAGGER_ENABLED=true