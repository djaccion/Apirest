# ADVERTENCIA: Este es un archivo de ejemplo/plantilla
# El archivo .env real NO debe ser versionado en el repositorio (agregar .env a .gitignore)
# Todos los valores marcados como SECRETO deben ser generados de forma segura antes del despliegue
# Copiar este archivo como .env y reemplazar todos los valores de ejemplo con valores reales y seguros

# ===== CONFIGURACIÓN DE LA APLICACIÓN =====

# Nombre descriptivo de la aplicación
APP_NAME=Deployment Management API

# Versión de la API expuesta en los endpoints
API_VERSION=v1

# Entorno de ejecución de la aplicación
# Valores válidos: development, staging, production
ENVIRONMENT=development

# Nivel de detalle del logging de la aplicación
# Valores válidos: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===== CONFIGURACIÓN DEL SERVIDOR =====

# Dirección IP en la que Uvicorn escuchará las conexiones entrantes
HOST=0.0.0.0

# Puerto en el que Uvicorn escuchará las conexiones entrantes
PORT=8000

# Activa el modo de recarga automática de Uvicorn al detectar cambios en el código
# Debe ser false en producción
RELOAD=true

# ===== SEGURIDAD JWT =====

# SECRETO: No versionar el valor real
# Clave secreta utilizada para firmar y verificar los tokens JWT
# DEBE ser reemplazada por una cadena aleatoria segura de mínimo 32 caracteres antes de cualquier despliegue
SECRET_KEY=your-super-secret-key-change-this-in-production

# Algoritmo criptográfico utilizado para la firma de los tokens JWT
JWT_ALGORITHM=HS256

# Tiempo de vida del token JWT expresado en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== BASE DE DATOS =====

# URL de conexión de SQLAlchemy para la base de datos
# Para producción se recomienda reemplazar por una URL de PostgreSQL con el formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL=sqlite:///./deployments.db

# Activa el echo de SQLAlchemy para mostrar las consultas SQL en los logs
# true es útil solo para depuración local, usar false en todos los demás entornos
DATABASE_ECHO=false

# ===== CREDENCIALES DEL USUARIO ADMINISTRADOR INICIAL =====

# Email del usuario administrador que se creará durante la inicialización de la aplicación
ADMIN_EMAIL=admin@example.com

# SECRETO: No versionar el valor real
# Contraseña del usuario administrador inicial
# Debe cumplir política de contraseñas seguras y ser cambiada inmediatamente tras el primer despliegue
ADMIN_PASSWORD=ChangeThisPassword123!

# ===== CONFIGURACIÓN CORS =====

# Orígenes permitidos para las solicitudes CORS separados por coma
# En producción se deben listar únicamente los dominios autorizados separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080