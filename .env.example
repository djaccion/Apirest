# Application Identity
APP_NAME=xp9-api
APP_VERSION=1.0.0
# Accepted values: development | staging | production
APP_ENV=development
# Port where Express server will listen
APP_PORT=3000

# ─────────────────────────────────────────────
# JWT SECURITY
# ─────────────────────────────────────────────

# Secret key used by jsonwebtoken to sign and verify tokens
# In production this MUST be a cryptographically strong random string (minimum 256 bits)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_STRONG_SECRET_MIN_256_BITS

# Token expiration time (e.g. 1h, 30m, 7d)
JWT_EXPIRES_IN=1h

# Issuer claim embedded in the JWT payload to identify this application
JWT_ISSUER=xp9-api

# ─────────────────────────────────────────────
# CORS CONFIGURATION
# ─────────────────────────────────────────────

# Comma-separated list of allowed origins
# Example for multiple origins: http://localhost:4200,https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3001

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────

# Time window size in milliseconds for rate limiting (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per IP within the time window
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────

# Winston log level — accepted values: error | warn | info | debug
# Use 'debug' for development, 'warn' or 'error' for production
LOG_LEVEL=debug

# Log output format — accepted values: json | simple
# Use 'json' for structured logging in production pipelines, 'simple' for local readability
LOG_FORMAT=simple

# ─────────────────────────────────────────────
# SWAGGER / API DOCUMENTATION
# ─────────────────────────────────────────────

# Enable or disable the /api-docs Swagger UI endpoint
# Set to false in production to avoid exposing API internals
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────
# FUTURE USE — MONGODB (NOT ACTIVE YET)
# ─────────────────────────────────────────────

# MongoDB connection URI — reserved for future integration with Mongoose
# MongoDB Atlas format:  mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local MongoDB format:  mongodb://localhost:27017/<dbname>
#MONGODB_URI=mongodb://localhost:27017/xp9-db