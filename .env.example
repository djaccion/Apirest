# ==============================================================================
# .env.example - PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# Este archivo es una PLANTILLA DE REFERENCIA para el equipo de desarrollo.
# NUNCA subas el archivo .env real al repositorio. Solo .env.example debe
# estar versionado como documentación compartida del equipo.
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Completa cada variable con los valores reales de tu entorno local.
#   3. Verifica que .env esté listado en .gitignore antes de hacer commit.
#      El archivo .env.example SÍ debe estar versionado en el repositorio.
#
# ADVERTENCIA: Este archivo NO debe contener valores reales de producción,
# contraseñas, tokens de API, claves privadas ni rutas absolutas específicas
# de ninguna máquina de desarrollo.
# ==============================================================================


# ------------------------------------------------------------------------------
# SECCIÓN 1: CONFIGURACIÓN GENERAL DE FLASK
# ------------------------------------------------------------------------------

# Entorno de ejecución de la aplicación Flask.
# Valores aceptados: development | testing | production
FLASK_ENV=development

# Activa o desactiva el modo debug de Flask.
# OBLIGATORIO: en producción este valor debe ser 0 sin excepción.
# Valores aceptados: 1 (activado) | 0 (desactivado)
FLASK_DEBUG=1

# Clave secreta usada por Flask para firmar sesiones y tokens de seguridad.
# NUNCA uses este valor de ejemplo en producción ni lo compartas.
# Genera un valor seguro con: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Host en el que el servidor Flask escuchará conexiones entrantes.
# Usa 0.0.0.0 para aceptar conexiones desde cualquier interfaz de red.
FLASK_RUN_HOST=0.0.0.0

# Puerto TCP en el que el servidor Flask estará disponible.
FLASK_RUN_PORT=5000


# ------------------------------------------------------------------------------
# SECCIÓN 2: CONFIGURACIÓN DE CORS
# ------------------------------------------------------------------------------

# Lista de orígenes permitidos para realizar peticiones cross-origin a la API.
# Separa múltiples orígenes con coma sin espacios.
# En producción debe contener únicamente los dominios reales del frontend.
# Ejemplo producción: https://tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000


# ------------------------------------------------------------------------------
# SECCIÓN 3: RATE LIMITING
# ------------------------------------------------------------------------------

# Límite global de peticiones aplicado por defecto a todos los endpoints.
# Sigue la sintaxis de Flask-Limiter: cantidad per periodo separados por punto y coma.
# Documentación: https://flask-limiter.readthedocs.io/en/stable/
RATELIMIT_DEFAULT=200 per day;50 per hour

# Backend de almacenamiento para los contadores de rate limiting.
# Usa memory:// únicamente en desarrollo local (no persiste entre reinicios).
# En producción se recomienda: redis://localhost:6379/0
RATELIMIT_STORAGE_URL=memory://

# Límite específico para el endpoint POST /api/validate-rut.
# Este valor sobreescribe el límite global únicamente para ese endpoint.
# Ajusta según la carga esperada y los requisitos de seguridad del sistema.
RATELIMIT_VALIDATE_ENDPOINT=10 per minute


# ------------------------------------------------------------------------------
# SECCIÓN 4: LOGGING Y AUDITORÍA
# ------------------------------------------------------------------------------

# Nivel mínimo de severidad que será registrado por el sistema de logging.
# Valores aceptados: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Ruta relativa o absoluta del archivo de auditoría rotativo.
# El directorio especificado debe existir previamente y tener permisos de escritura.
# Ejemplo: crea el directorio con: mkdir -p logs
LOG_FILE_PATH=logs/audit.log

# Tamaño máximo en bytes que puede alcanzar el archivo de log antes de rotar.
# 10485760 equivale a 10 MB (10 * 1024 * 1024 = 10485760 bytes).
LOG_MAX_BYTES=10485760

# Número de archivos de respaldo que conservará el RotatingFileHandler.
# Con valor 5 se mantendrán: audit.log, audit.log.1, ..., audit.log.5
LOG_BACKUP_COUNT=5


# ------------------------------------------------------------------------------
# SECCIÓN 5: SEGURIDAD Y HEADERS HTTP
# ------------------------------------------------------------------------------

# Valor del header Content-Security-Policy enviado en cada respuesta HTTP.
# Restringe las fuentes desde las que el navegador puede cargar recursos.
# Ajusta este valor si la aplicación carga recursos externos como fuentes o CDN.
# Ejemplo con fuentes externas: default-src 'self'; font-src 'self' fonts.googleapis.com
CONTENT_SECURITY_POLICY=default-src 'self'

# Tiempo en segundos para el header Strict-Transport-Security (HSTS).
# 31536000 equivale a 1 año (365 * 24 * 60 * 60 = 31536000 segundos).
# IMPORTANTE: este header solo tiene efecto sobre conexiones HTTPS.
HSTS_MAX_AGE=31536000

# Valor del header X-Frame-Options para protección contra ataques de clickjacking.
# Valores aceptados: DENY | SAMEORIGIN
# DENY impide que la página sea embebida en cualquier iframe externo o propio.
X_FRAME_OPTIONS=DENY